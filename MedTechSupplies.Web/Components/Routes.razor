<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
            <Authorizing>
                <p style="padding:60px;text-align:center;color:#5b6b82">Authorizing…</p>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div style="padding:80px 20px;text-align:center">
                <h1>Page not found</h1>
                <p style="color:#5b6b82">The page you're looking for doesn't exist.</p>
                <a href="/" class="btn btn-primary" style="margin-top:14px">Back to home</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
