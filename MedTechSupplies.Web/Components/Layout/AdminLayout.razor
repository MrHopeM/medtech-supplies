@inherits LayoutComponentBase

<div class="admin-shell">
    <aside class="sidebar">
        <div class="brand">
            <img src="images/logo-mark.svg" alt="MedTech" />
            <div class="t">MedTech<small>Admin</small></div>
        </div>
        <nav>
            <NavLink href="/admin" Match="NavLinkMatch.All"><span class="ic"><Icon Name="message" /></span> Enquiries</NavLink>
        </nav>
        <div class="spacer"></div>
        <AuthorizeView>
            <div style="padding:10px 14px;font-size:12.5px;color:#9fc0db">
                Signed in as<br /><strong style="color:#fff">@(context.User.FindFirst(ClaimTypes.GivenName)?.Value ?? context.User.Identity?.Name)</strong>
            </div>
        </AuthorizeView>
        <a class="side-link" href="/" target="_blank"><Icon Name="globe" /> View storefront</a>
        <form method="post" action="/account/logout" data-enhance="false" style="margin:0">
            <button type="submit" class="side-link" style="width:100%"><Icon Name="logout" /> Sign out</button>
        </form>
    </aside>
    <main class="admin-main">
        @Body
    </main>
</div>
