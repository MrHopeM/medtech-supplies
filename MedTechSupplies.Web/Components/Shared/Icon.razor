@* Lightweight inline-SVG icon set (Lucide-style line icons) for a clean, professional look. *@
<svg class="ic-svg @CssClass" viewBox="0 0 24 24" width="1em" height="1em" fill="none"
     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @((MarkupString)(Paths.TryGetValue(Name, out var p) ? p : Paths["dot"]))
</svg>

